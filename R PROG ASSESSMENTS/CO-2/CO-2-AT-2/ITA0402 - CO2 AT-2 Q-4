# Q4: Relationship between Monthly Income and Purchase Amount
# ---- Dataset (simulated retail data; same block in every question) ----
set.seed(123); n <- 200
cats <- c("Electronics","Clothing","Groceries","Home Decor","Beauty")
Customer_ID       <- paste0("C", 1001:(1000 + n))
Gender            <- sample(c("Male","Female"), n, replace = TRUE)
Age               <- sample(18:65, n, replace = TRUE)
City              <- sample(c("Chennai","Mumbai","Delhi","Bengaluru","Hyderabad"), n, replace = TRUE)
Membership_Status <- sample(c("Premium","Regular"), n, replace = TRUE, prob = c(0.4, 0.6))
Store_Type        <- sample(c("Urban","Semi-Urban","Rural"), n, replace = TRUE, prob = c(0.4, 0.3, 0.3))
Monthly_Income    <- round(pmax(15000, rnorm(n, 45000, 12000)), -2)
Purchase_Amount   <- 0.04 * Monthly_Income * exp(rnorm(n, 0, 0.45)) *
                     ifelse(Gender == "Male", 1.2, 1) * ifelse(Membership_Status == "Premium", 1.1, 1)
Purchase_Amount   <- round(Purchase_Amount / 50) * 50
Customer_Rating   <- 3.4 + ifelse(Membership_Status == "Premium", 0.4, 0) +
                     ifelse(Store_Type == "Urban", 0.25, ifelse(Store_Type == "Rural", -0.25, 0)) + rnorm(n, 0, 0.8)
Customer_Rating   <- round(pmin(5, pmax(1, Customer_Rating)), 1)
Product_Category  <- ifelse(Membership_Status == "Premium",
                            sample(cats, n, TRUE, prob = c(0.30, 0.25, 0.10, 0.15, 0.20)),
                            sample(cats, n, TRUE, prob = c(0.15, 0.20, 0.35, 0.15, 0.15)))
df <- data.frame(Customer_ID, Gender, Age, City, Product_Category, Purchase_Amount,
                 Monthly_Income, Customer_Rating, Membership_Status, Store_Type)
# ---- Analysis ----
r_pearson  <- cor(df$Monthly_Income, df$Purchase_Amount)
r_spearman <- cor(df$Monthly_Income, df$Purchase_Amount, method = "spearman")
cat("Pearson correlation  :", round(r_pearson, 3), "\n")
cat("Spearman correlation :", round(r_spearman, 3), "\n")

strength  <- if (abs(r_pearson) >= 0.7) "strong" else if (abs(r_pearson) >= 0.4) "moderate" else "weak"
direction <- if (r_pearson > 0) "positive" else "negative"
cat("Interpretation: a", strength, direction, "relationship.\n")

cat("\nCorrelation test:\n")
print(cor.test(df$Monthly_Income, df$Purchase_Amount))

model <- lm(Purchase_Amount ~ Monthly_Income, data = df)
cat("\nSimple Linear Regression:\n"); print(summary(model))
cat("R-squared:", round(summary(model)$r.squared, 3), "\n")

plot(df$Monthly_Income, df$Purchase_Amount, pch = 19, col = "steelblue",
     main = "Monthly Income vs Purchase Amount",
     xlab = "Monthly Income (Rs.)", ylab = "Purchase Amount (Rs.)")
abline(model, col = "red", lwd = 2)