# Q6: Fibonacci series using for loop and while loop
n <- 10

cat("Fibonacci using for loop:\n")
a <- 0; b <- 1
for (i in 1:n) {
  cat(a, " ")
  temp <- a + b
  a <- b
  b <- temp
}

cat("\n\nFibonacci using while loop:\n")
a <- 0; b <- 1; i <- 1
while (i <= n) {
  cat(a, " ")
  temp <- a + b
  a <- b
  b <- temp
  i <- i + 1
}
cat("\n")